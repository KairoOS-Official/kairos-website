# ===================================================
# Configuration KaïroOS — Backend API & Web Application
# ===================================================

# --- PORTS & SERVEUR ---
# PORT : Port du serveur API Fastify (qui sert aussi les pages compilées en production)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# VITE_PORT : Port du serveur de développement Frontend Vite avec Hot-Reload (5173 par défaut)
VITE_PORT=5173

# --- BASE DE DONNÉES (ADAPTABLE LOCAL ↔ SUPABASE) ---
# DB_DRIVER : 'sqlite' (par défaut) ou 'supabase' / 'postgres'
DB_DRIVER=sqlite

# Configuration SQLite Locale
SQLITE_DB_PATH=data/kairoos.db

# Configuration Supabase / PostgreSQL (utilisée si DB_DRIVER=supabase)
# DATABASE_URL=postgres://postgres:[VOTRE_MOT_DE_PASSE]@db.[VOTRE_PROJET].supabase.co:5432/postgres
# SUPABASE_URL=https://[VOTRE_PROJET].supabase.co
# SUPABASE_ANON_KEY=[VOTRE_CLE_ANON]

# --- SÉCURITÉ & SESSIONS ---
SESSION_SECRET=change_me_super_secret_session_key_kairo_2026

# --- PANNEAU D'ADMINISTRATION MODULAIRE ---
# ADMIN_PATH : Chemin d'accès Web vers le panneau d'administration (par défaut 'admin' -> /admin)
# Vous pouvez le changer pour dissimuler la page d'administration (ex: ADMIN_PATH=secret-portal)
ADMIN_PATH=admin

# ADMIN_PORT (Optionnel) : Si spécifié, le portail Admin écoute sur un port dédié isolé (ex: 3001)
# et la route d'admin sera désactivée sur le port public 3000.
# ADMIN_PORT=3001

# Restrictions IP pour l'accès Admin
ADMIN_ALLOW_ALL=false
ADMIN_ALLOWED_IPS=127.0.0.1,::1
